{
  "name": "moire-installer",
  "version": "0.1.0",
  "private": true,
  "description": "MOLIVE에서 만든 디자인을 Cafe24 쇼핑몰에 설치하는 Windows 데스크톱 도우미",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "dist": "npm run build && electron-builder --win",
    "verify:storage": "npm run build && electron scripts/verify-safe-storage.cjs release/storage-check.json"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ssh2": "^1.15.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "author": "MOLIVE",
  "build": {
    "appId": "com.moire.installer",
    "productName": "MOLIVE Installer",
    "copyright": "MOLIVE",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "molive_app_icon.ico"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MOLIVE Installer",
      "artifactName": "MOLIVE-Installer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MOLIVE-Installer-${version}-portable.${ext}"
    }
  }
}
