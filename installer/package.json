{
  "name": "moire-installer",
  "version": "0.1.0",
  "private": true,
  "description": "Moiré에서 만든 디자인을 카페24 쇼핑몰에 설치하는 Windows 데스크톱 도우미",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ssh2": "^1.15.5",
    "electron": "^43.4.1",
    "typescript": "^5.9.3"
  }
}
